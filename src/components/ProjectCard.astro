---
interface Props {
  title: string;
  description: string;
  category: 'Web App' | 'Desktop' | 'Mobile Game' | '3D Animation' | string;
  techStack: string[];
  thumbnail: string;
  repoUrl?: string;
  demoUrl?: string;
}

const { title, description, category, techStack, thumbnail, repoUrl, demoUrl } = Astro.props;

// Konfigurasi tema warna neon & border glow berdasarkan kategori karya
const categoryThemeMap: Record<string, { border: string; badge: string; text: string; glow: string }> = {
  'Web App': {
    border: 'hover:border-cyan-400/60 hover:shadow-[0_12px_35px_rgba(34,211,238,0.12)]',
    badge: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
    text: 'group-hover:text-cyan-400',
    glow: 'rgba(34, 211, 238, 0.12)'
  },
  'Desktop': {
    border: 'hover:border-purple-400/60 hover:shadow-[0_12px_35px_rgba(168,85,247,0.12)]',
    badge: 'bg-purple-500/10 text-purple-300 border-purple-500/30',
    text: 'group-hover:text-purple-400',
    glow: 'rgba(168, 85, 247, 0.12)'
  },
  'Mobile Game': {
    border: 'hover:border-emerald-400/60 hover:shadow-[0_12px_35px_rgba(16,185,129,0.12)]',
    badge: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
    text: 'group-hover:text-emerald-400',
    glow: 'rgba(16, 185, 129, 0.12)'
  },
  '3D Animation': {
    border: 'hover:border-amber-400/60 hover:shadow-[0_12px_35px_rgba(245,158,11,0.12)]',
    badge: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
    text: 'group-hover:text-amber-400',
    glow: 'rgba(245, 158, 11, 0.12)'
  }
};

const theme = categoryThemeMap[category] || categoryThemeMap['Web App'];
---

<div 
  class={`project-card group relative rounded-3xl bg-zinc-900/50 border border-zinc-800/80 ${theme.border} backdrop-blur-xl transition-all duration-300 ease-out flex flex-col overflow-hidden hover:-translate-y-1.5`}
  data-glow-color={theme.glow}
>
  <!-- Interactive Radial Spotlight On Card Hover -->
  <div class="card-radial-spotlight pointer-events-none absolute inset-0 -z-10 transition-opacity duration-300 opacity-0 group-hover:opacity-100"></div>

  <!-- 1. THUMBNAIL WRAPPER (Cinematic Zoom & Lightening) -->
  <div class="relative h-52 w-full overflow-hidden bg-zinc-950">
    <img 
      src={thumbnail} 
      alt={title} 
      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 filter brightness-[0.88] group-hover:brightness-105"
      loading="lazy"
    />

    <!-- Gradient Edge Softener -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent opacity-80"></div>

    <!-- Category Pill Badge -->
    <div class="absolute top-3.5 left-3.5">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold backdrop-blur-md border ${theme.badge} shadow-lg`}>
        <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
        {category}
      </span>
    </div>
  </div>

  <!-- 2. CONTENT BODY -->
  <div class="p-6 flex flex-col flex-grow relative z-10">
    <h3 class={`text-lg font-bold text-white ${theme.text} transition-colors duration-200 mb-2 leading-snug`}>
      {title}
    </h3>

    <p class="text-xs sm:text-sm text-zinc-400 line-clamp-2 leading-relaxed mb-5 flex-grow">
      {description}
    </p>

    <!-- Tech Stack Micro-Badges -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {techStack.map((tech) => (
        <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-zinc-950/70 text-zinc-300 border border-zinc-800/80 group-hover:border-zinc-700/60 transition-colors">
          {tech}
        </span>
      ))}
    </div>

    <!-- 3. INTERACTIVE ACTION LINKS WITH MICRO-ANIMATIONS -->
    <div class="flex items-center justify-between pt-4 border-t border-zinc-800/60 text-xs font-semibold mt-auto">
      
      <!-- Repository Link: Interactive Spinning GitHub & Sliding Arrow -->
      {repoUrl ? (
        <a 
          href={repoUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group/repo inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-zinc-950/70 hover:bg-zinc-800/80 border border-zinc-800/80 hover:border-zinc-700 text-zinc-300 hover:text-white transition-all duration-200"
        >
          <!-- GitHub SVG Icon -->
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/repo:rotate-12 group-hover/repo:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span data-id="Repositori" data-en="Code">Repositori</span>
          
          <!-- Animated Diagonal Arrow -->
          <svg class="w-3 h-3 text-zinc-500 group-hover/repo:text-cyan-400 group-hover/repo:translate-x-0.5 group-hover/repo:-translate-y-0.5 transition-all duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25"/>
          </svg>
        </a>
      ) : <div />}

      <!-- Live Demo Link: Radar Pulse Dot & Expanding Arrow -->
      {demoUrl && (
        <a 
          href={demoUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group/demo relative inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-gradient-to-r from-cyan-500/10 to-blue-600/10 hover:from-cyan-500 hover:to-blue-600 border border-cyan-500/30 hover:border-cyan-400 text-cyan-300 hover:text-white transition-all duration-300 shadow-sm hover:shadow-[0_0_20px_rgba(6,182,212,0.4)]"
        >
          <!-- Radar Pulse Micro-Dot -->
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400 group-hover/demo:bg-white transition-colors"></span>
          </span>

          <span data-id="Live Demo" data-en="Live Preview">Live Demo</span>

          <!-- Animated Sliding Arrow -->
          <svg class="w-3 h-3 transition-transform duration-200 group-hover/demo:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</div>