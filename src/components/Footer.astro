---
const currentYear = new Date().getFullYear();

// Daftar navigasi cepat (mendukung translasi ID/EN otomatis)
const navLinks = [
  { nameId: "Beranda", nameEn: "Home", href: "#" },
  { nameId: "Tentang Saya", nameEn: "About Me", href: "#about" },
  { nameId: "Showcase Karya", nameEn: "Featured Works", href: "#showcase" },
  { nameId: "Hubungi Saya", nameEn: "Contact", href: "#contact" },
];

// Daftar sosial media dengan URL asli & ikon SVG sleek
const socialLinks = [
  {
    name: "GitHub",
    handle: "@TrezzaL",
    url: "https://github.com/TrezzaL",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 18c-4.51 2-5-2-7-2"/>`
  },
  {
    name: "YouTube",
    handle: "@TrezzaL",
    url: "https://www.youtube.com/@TrezzaL",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path stroke-linecap="round" stroke-linejoin="round" d="m10 15 5-3-5-3v6Z"/>`
  },
  {
    name: "TikTok",
    handle: "@trezzal",
    url: "https://www.tiktok.com/@trezzal",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>`
  },
  {
    name: "Instagram",
    handle: "@choirlrizl_",
    url: "https://instagram.com/choirlrizl_",
    icon: `<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>`
  },
  {
    name: "LinkedIn",
    handle: "mchoirulrizal",
    url: "https://www.linkedin.com/in/mchoirulrizal/",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`
  }
];
---

<footer class="relative bg-zinc-950 border-t border-zinc-800/70 pt-16 pb-10 overflow-hidden transition-colors duration-300">
  <!-- Garis Cahaya Neon Horizontal di Atas Footer -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent shadow-[0_0_20px_#22d3ee]"></div>
  
  <!-- Ambient Glow Background -->
  <div class="absolute -bottom-32 left-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -top-32 right-1/4 w-80 h-80 bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- GRID UTAMA (Asymmetric 12-Column Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-14 border-b border-zinc-800/60">
      
      <!-- KOLOM 1: Branding, Tagline & Status (4 Kolom) -->
      <div class="lg:col-span-4 space-y-5">
        <a href="#" class="inline-flex items-center gap-3 group">
          <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-500/30 group-hover:border-cyan-400 transition-all duration-300 shadow-inner">
            <span class="font-extrabold text-sm tracking-tighter bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">CR</span>
            <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-white group-hover:text-cyan-400 transition-colors block leading-none">
              Choirul Rizal<span class="text-cyan-400">.</span>
            </span>
            <span class="text-[11px] font-mono text-zinc-400 tracking-widest uppercase">
              Software &bull; Visuals
            </span>
          </div>
        </a>

        <p 
          class="text-sm text-zinc-400 leading-relaxed max-w-sm"
          data-id="Merancang arsitektur kode yang tangguh dan mengemas cerita visual yang memikat untuk brand maupun produk digital."
          data-en="Crafting resilient code architectures and compelling visual stories for digital products and brands."
        >
          Merancang arsitektur kode yang tangguh dan mengemas cerita visual yang memikat untuk brand maupun produk digital.
        </p>

        <!-- Badge Status & Jam Lokal -->
        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs text-zinc-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]"></span>
            <span data-id="Tersedia untuk Freelance" data-en="Available for Freelance">Tersedia untuk Freelance</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-zinc-900/50 border border-zinc-800/80 text-xs font-mono text-zinc-400">
            <span>🕒</span>
            <span id="local-time">WIB (UTC+7)</span>
          </div>
        </div>
      </div>

      <!-- KOLOM 2: Navigasi Cepat (2 Kolom) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 
          class="text-xs font-bold uppercase tracking-wider text-zinc-200"
          data-id="Navigasi"
          data-en="Navigation"
        >
          Navigasi
        </h3>
        <ul class="space-y-2.5">
          {navLinks.map((link) => (
            <li>
              <a 
                href={link.href}
                class="group inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-cyan-400 transition-all duration-200"
              >
                <span class="w-0 h-[1.5px] bg-cyan-400 transition-all duration-300 group-hover:w-3"></span>
                <span class="group-hover:translate-x-0.5 transition-transform duration-200" data-id={link.nameId} data-en={link.nameEn}>
                  {link.nameId}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- KOLOM 3: Kontak & Sosial Media Sleek (3 Kolom) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 
          class="text-xs font-bold uppercase tracking-wider text-zinc-200"
          data-id="Koneksi & Sosial"
          data-en="Connect & Socials"
        >
          Koneksi & Sosial
        </h3>
        <ul class="space-y-2">
          {socialLinks.map((social) => (
            <li>
              <a 
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between p-2 -mx-2 rounded-xl hover:bg-zinc-900/80 border border-transparent hover:border-zinc-800/80 transition-all duration-200"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400 group-hover:text-cyan-400 group-hover:border-cyan-500/40 group-hover:scale-105 transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" set:html={social.icon} />
                  </div>
                  <div>
                    <span class="text-xs font-semibold text-zinc-200 group-hover:text-white block leading-none">
                      {social.name}
                    </span>
                    <span class="text-[11px] text-zinc-400 font-mono">
                      {social.handle}
                    </span>
                  </div>
                </div>
                <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-cyan-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- KOLOM 4: Call to Action Card & Unduh CV (3 Kolom) -->
      <div class="lg:col-span-3">
        <div class="p-5 rounded-2xl bg-zinc-900/50 border border-zinc-800/90 backdrop-blur-md space-y-4 relative overflow-hidden group hover:border-cyan-500/40 transition-all duration-300">
          <div class="absolute -right-10 -top-10 w-28 h-28 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all"></div>
          
          <div class="space-y-1.5 relative z-10">
            <span class="text-[11px] font-semibold text-cyan-400 uppercase tracking-wider" data-id="Siap Berkolaborasi?" data-en="Ready to Collaborate?">
              Siap Berkolaborasi?
            </span>
            <h4 class="text-base font-bold text-white leading-snug" data-id="Mari bangun sesuatu yang keren bersama." data-en="Let's build something great together.">
              Mari bangun sesuatu yang keren bersama.
            </h4>
            <p class="text-xs text-zinc-400 leading-relaxed" data-id="Unduh ringkasan profilku atau langsung jadwalkan obrolan singkat." data-en="Download my resume or schedule a quick chat directly.">
              Unduh ringkasan profilku atau langsung jadwalkan obrolan singkat.
            </p>
          </div>

          <div class="space-y-2.5 pt-1 relative z-10">
            <!-- Tombol Unduh CV -->
            <a 
              href="/cv-choirul-rizal.pdf" 
              download
              class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold text-xs flex items-center justify-center gap-2 hover:opacity-95 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] active:scale-[0.98] transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15V3m0 12-4-4m4 4 4-4M2 17l.621 2.485A2 2 0 0 0 4.561 21h14.878a2 2 0 0 0 1.94-1.515L22 17"/>
              </svg>
              <span data-id="Unduh CV / Resume" data-en="Download CV / Resume">Unduh CV / Resume</span>
            </a>

            <!-- Tombol Diskusi Cepat -->
            <a 
              href="#contact"
              class="w-full py-2.5 px-4 rounded-xl bg-zinc-950/80 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all duration-200"
            >
              <span data-id="Mulai Proyek" data-en="Start a Project">Mulai Proyek</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- TIPOGRAFI BESAR DEKORATIF (Watermark Modern) -->
    <div class="py-6 select-none overflow-hidden flex justify-center border-b border-zinc-800/40">
      <span class="text-4xl sm:text-7xl md:text-8xl font-black tracking-tighter bg-gradient-to-b from-zinc-800/50 to-transparent bg-clip-text text-transparent hover:from-cyan-500/30 transition-all duration-700 cursor-default">
        CHOIRUL RIZAL
      </span>
    </div>

    <!-- SUB-FOOTER: Copyright, Micro-copy & Back to Top -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
        <p>
          &copy; {currentYear} <strong class="text-zinc-200 font-semibold">Choirul Rizal</strong>. All rights reserved.
        </p>
      </div>

      <p class="flex items-center gap-1.5 text-zinc-400">
        <span data-id="Dibuat dengan" data-en="Made with">Dibuat dengan</span>
        <span class="text-amber-400 animate-bounce inline-block">☕</span>
        <span data-id="dan penuh dedikasi di Indonesia" data-en="and passion in Indonesia">dan penuh dedikasi di Indonesia</span>
      </p>

      <!-- Tombol Back to Top Interaktif -->
      <button 
        id="back-to-top"
        type="button"
        class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 hover:border-cyan-500/40 text-zinc-300 hover:text-cyan-400 transition-all duration-200"
      >
        <span data-id="Kembali ke atas" data-en="Back to top">Kembali ke atas</span>
        <svg class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m18 15-6-6-6 6"/>
        </svg>
      </button>
    </div>

  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Update Jam Lokal Real-time (WIB)
    const timeEl = document.getElementById('local-time');
    function updateClock() {
      if (!timeEl) return;
      const now = new Date();
      const options = { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      const timeString = new Intl.DateTimeFormat('id-ID', options).format(now);
      timeEl.textContent = `${timeString} WIB`;
    }
    updateClock();
    setInterval(updateClock, 1000);

    // 2. Smooth Scroll ke Atas
    const backToTopBtn = document.getElementById('back-to-top');
    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>